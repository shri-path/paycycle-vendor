#!/bin/sh
echo "🔍 [1/3] Linting all chunks..."
if ! npm run lint; then
  echo "❌ Lint failed. Commit aborted — fix the issues above (try: npm run lint:fix)."
  exit 1
fi

echo "🌐 [2/3] Auditing locales for untranslated strings..."
if ! npm run audit:locales; then
  echo "❌ Locale audit failed. Commit aborted — translate the keys listed above in every non-English locale."
  exit 1
fi

# tsc fails with TS18003 when there are zero source files; skip typecheck until src has code.
if find src -name '*.ts' -o -name '*.tsx' 2>/dev/null | grep -q .; then
  echo "🏗️  [3/3] Type checking project..."
  if ! npm run typecheck; then
    echo "❌ Type check failed. Commit aborted — fix the type errors above."
    exit 1
  fi
else
  echo "🏗️  [3/3] No source files in src/ yet — skipping typecheck."
fi

echo "✅ Lint + locale audit + typecheck clean. Proceeding with commit."
