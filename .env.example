# PayCycle Vendor — environment variables
# Copy to .env for local development, .env.production for production builds
#
# Expo uses EXPO_PUBLIC_ prefix for client-side env vars (REACT_APP_* is not supported)

# API mode: 'mock' for local dev, 'real' for staging/production
EXPO_PUBLIC_API_MODE=mock

# Backend API base URL (without trailing slash)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Socket.IO server URL
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000
